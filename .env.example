# ---- LLM (DeepSeek via the OpenAI-compatible SDK; nothing else is supported) ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
# Max concurrent LLM calls across all running audits
LLM_CONCURRENCY=6
LLM_TIMEOUT_SECONDS=120

# ---- Audit engine ----
ENGINE_DIR=../engine
EPHEMERAL_TTL_MINUTES=60   # reports and tracker runs are kept in memory only, then erased
SCRIPT_TIMEOUT_SECONDS=90
AUDIT_RATE_LIMIT_PER_HOUR=10
# Set to 1 to allow auditing private hosts (dev only; engine honours CLAUDE_SEO_LOCAL_TARGETS)
CLAUDE_SEO_LOCAL_TARGETS=

# ---- Optional Google API tiers (claude-seo seo-google) ----
GOOGLE_API_KEY=
# Optional engine adapters for the AI Visibility Tracker (real measured data)
PERPLEXITY_API_KEY=
BRIGHTDATA_API_KEY=

# ---- Demo ----
# Clearly labelled demo data. Never enable in production.
DEMO_MODE=0

# ---- Frontend ----
# Browser-facing API origin, used for the SSE stream (must be allowed by CORS_ORIGINS below)
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000
